   "source": [
    "import numpy as np\n",
    "path = \"spring_data_no_control.csv\"\n",
    "raw = np.loadtxt(path, delimiter=\",\", skiprows=0)\n",
    "M= int(raw[:, 0].max()) + 1\n",
    "N =raw.shape[0] // M"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "2e2dd067",
   "metadata": {},
   "outputs": [],
   "source": [
    "Qdot = np.zeros(M)\n",
    "for k in range(M):\n",
    "    Qdot[k] = raw[k*N, 3]"
   ]
  },
